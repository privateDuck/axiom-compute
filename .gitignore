# --- 1. Build & Output Directories ---
# CMake build folders (Common names)
build/
cmake-build-*/
out/

# Visual Studio output folders
x64/
x86/
Debug/
Release/

# You mentioned a folder named 'atlas' contains VS object files.
# We ignore the FOLDER 'atlas/', but NOT the file 'atlas.cpp'.
atlas/
!atlas.cpp

# --- 2. IDE & Editor Files ---
# CLion
.idea/

# Visual Studio (Hidden settings)
.vs/
*.user
*.suo

# VS Code
.vscode/

# --- 3. Binary & Compiled Files ---
# Ignore executables and artifacts
*.exe
*.obj
*.pdb
*.idb
*.ilk
*.exp

# --- 4. Libraries (Handling your 'lib' folder) ---
# Generally ignore static libs (generated by build)
*.lib
*.dll

# ...BUT force-include your external static libs in the 'lib' folder
# (so DuckDB.lib gets committed)
!lib/
!lib/*.lib
!lib/*.dll

# --- 5. Dependencies & Package Managers ---
# Vcpkg (if you ever switch to local install)
vcpkg_installed/
vcpkg/

# Python (if you used scripts)
__pycache__/
*.pyc

# --- 6. OS Generated ---
Thumbs.db
Desktop.ini
.DS_Store